# Local edge: http, no ACME, one host with routing by path.
# The host taimen.localhost serves both the browser and the containers (a network alias
# of the caddy service), so the IAM and Keycloak issuer is the same on both sides.
#
# Production installation: your own Caddyfile with a domain (Caddy issues TLS) and the
# same path layout; the path to the file is the CADDYFILE variable in .env.
{
	auto_https off

	# The default log: errors of request handling (http.log.error.*, for example a 502 of an
	# unavailable upstream) are written here together with the whole request, and the access
	# log filter of the site does not apply to them. The same rules: neither the address of a
	# people search nor the code and state of an OAuth callback.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp "(?i)((?:e|%[46]5)(?:m|%[46]d)(?:a|%[46]1)(?:i|%[46]9)(?:l|%[46]c)|(?:c|%[46]3)(?:o|%[46]f)(?:d|%[46]4)(?:e|%[46]5)|(?:s|%[57]3)(?:t|%[57]4)(?:a|%[46]1)(?:t|%[57]4)(?:e|%[46]5))=[^&#]*" "$1=REDACTED"
			}
		}
	}
}

# host.docker.internal: a fleet node on the same machine (deploy/node/) — its containers reach
# the installation by this name (Docker Desktop resolves it; on Linux use the host's address).
http://taimen.localhost, http://localhost, http://host.docker.internal {
	# Artifact contents are not compressed: the core's ETag is the sha256 of the bytes, and
	# encode appends "-gzip" to it, so the client rejects the download as
	# content_integrity_failed. The assistant's streams (the console's SSE and the
	# launcher's surface) are not compressed either: encode would hold the events back.
	@compressible {
		not path_regexp ^/api/v1/artifacts/[^/]+/content$
		not path /console/api/assistant/stream
		not path_regexp ^/harness/_launcher/internal/principals/[^/]+/surface/stream$
	}
	encode @compressible zstd gzip

	# IAM exposes only what clients need: JWKS, PAT exchange/introspection/revocation,
	# client credentials exchange for service accounts, federation:*, SCIM, healthz.
	# The administrative surface (/api/v1/tenants/* except federation:*,
	# /api/v1/events) is protected only by the bootstrap token — it is not at the edge;
	# deploy/bootstrap.py reaches IAM via 127.0.0.1. Second line of defence: the
	# bootstrap token header is stripped before proxying.
	# Matching people of an external system by a connector: exactly the search by e-mail,
	# reading identities by issuer, linking and unlinking a connection identity — each with
	# its method; every other route about people stays closed. All four require a Bearer
	# token with iam:identities.link or iam:people.
	handle_path /iam/* {
		@iam_admin {
			path /api/v1/events /api/v1/events/* /api/v1/tenants /api/v1/tenants/*
			not path_regexp ^/api/v1/tenants/[^/]+/federation:(authenticate|exchange)$
			not {
				method GET
				path_regexp ^/api/v1/tenants/[^/]+/(principals:by-email|external-identities)$
			}
			not {
				method POST
				path_regexp ^/api/v1/tenants/[^/]+/principals/[^/]+/external-identities$
			}
			not {
				method DELETE
				path_regexp ^/api/v1/tenants/[^/]+/principals/[^/]+/external-identities/[^/]+$
			}
		}
		respond @iam_admin 404
		request_header -X-IAM-Bootstrap-Token
		reverse_proxy iam-service:8010
	}

	# Keycloak (idp and console profiles) itself lives under /auth, hence handle without
	# stripping the path.
	handle /auth/* {
		reverse_proxy keycloak:8080 {
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# notification-service (notify profile): web inbox, Telegram webhook.
	handle_path /notify/* {
		reverse_proxy notification-service:8000
	}

	# fleet (fleet profile): nodes join, pull their desired state and report only with
	# outgoing requests; administration needs a token of the fleet audience.
	handle_path /fleet/* {
		reverse_proxy fleet-controller:8040
	}

	# Memory is exposed only in the local setup; a production installation does not
	# publish it: clients get context through the Control Plane.
	handle_path /memory/* {
		reverse_proxy memory-service:8077
	}

	# Personal assistants (harness profile). The assistant has no web interface of its own:
	# people talk to it in the console, so behind the launcher only its service routes are
	# exposed — the conversation surface and the channel entry (/_launcher/internal/*, an
	# IAM Bearer token) and health. The console and the notification service reach the
	# launcher over the compose network, past the edge. The launcher's headers are not
	# accepted from outside — only the launcher sets them (HMAC with the container secret).
	@harness_service path /harness/_launcher/internal/* /harness/_launcher/health
	handle @harness_service {
		request_header -X-Harness-Launcher
		request_header -X-Harness-Principal
		reverse_proxy harness-launcher:8080 {
			flush_interval -1
		}
	}

	# Everything else under /harness — browser entry and bookmarks — goes to the console
	# with the assistant panel open.
	@harness_ui path /harness /harness/*
	handle @harness_ui {
		redir * /console/?assistant=open 302
	}

	# The platform guide (guide/, static MkDocs in the guide container).
	redir /guide /guide/ 301
	handle_path /guide/* {
		reverse_proxy guide:8080
	}

	# /metrics is not exposed at the edge (no authentication, it reveals counters):
	# metrics are scraped inside the compose network. The API schema (/openapi.json, /docs,
	# /redoc) is public on purpose: it is the contract for clients and executors, with no secrets.
	@cp_api path /api/v1/* /health/* /docs /docs/* /redoc /redoc/* /openapi.json
	handle @cp_api {
		reverse_proxy control-plane-api:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# The web console (console profile): the BFF itself lives under /console — OIDC sign-in,
	# API, the events WebSocket, the assistant's SSE and the SPA. Caddy sets X-Forwarded-*
	# itself, WebSocket passes reverse_proxy as is; flush_interval -1 — streams unbuffered.
	redir /console /console/ 301
	handle /console/* {
		reverse_proxy console:8090 {
			flush_interval -1
		}
	}

	# The root leads to the guide: it is served by the default profiles (core edge);
	# the console is at /console/ once the console profile is started.
	handle {
		redir * /guide/ 302
	}

	log {
		output stderr
		format filter {
			wrap console
			fields {
				# the address of a people search and the code and state of the core's OAuth
				# callback do not go from the query into the log for any request; the parameter
				# name is matched case-insensitively and with %-encoded letters
				request>uri regexp "(?i)((?:e|%[46]5)(?:m|%[46]d)(?:a|%[46]1)(?:i|%[46]9)(?:l|%[46]c)|(?:c|%[46]3)(?:o|%[46]f)(?:d|%[46]4)(?:e|%[46]5)|(?:s|%[57]3)(?:t|%[57]4)(?:a|%[46]1)(?:t|%[57]4)(?:e|%[46]5))=[^&#]*" "$1=REDACTED"
			}
		}
	}
}
