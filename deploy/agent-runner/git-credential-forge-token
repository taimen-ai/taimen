#!/bin/sh
# The git credential helper of the agent runner: hands out a forge token from a file and
# reads the file again on EVERY git request. A fleet node mints a GitHub App installation
# token about every 50 minutes and puts it by an atomic replace into the replica's mounted
# directory (/run/fleet/forge-token), so a refreshed token is seen without a restart.
#
# There may be several files (--file repeats): on every request the first non-empty one in
# order is taken. An agent with a static github-token thus gets the forge token as soon as
# the node issues it, even if the first minting failed and the file did not exist when the
# container started.
#
# The token is not cached and goes neither into .git/config, nor into a URL, nor into the
# environment: `store` and `erase` are ignored, the git configuration holds only file paths.
# It answers only https requests to one forge host; for other hosts, for a request with a
# repeated protocol=/host=, and for missing or empty files the answer is empty (git asks the
# next helper).
#
#   credential.helper = /usr/local/bin/git-credential-forge-token [--file F]... [--host H]
#
# Files — --file (in order), otherwise FORGE_TOKEN_FILE (default /run/fleet/forge-token)
# followed by /run/secrets/github-token. Host — --host, otherwise FORGE_HOST, otherwise
# github.com. Paths are not expanded as globs: `for file in $files` below.
set -uf

# Never read more from any file: a symlink to /dev/zero does not hang git.
MAX_TOKEN_BYTES=8192

files=""
nl='
'
host="${FORGE_HOST:-github.com}"
while [ $# -gt 1 ]; do
  case "$1" in
    --file) files="$files$2$nl"; shift 2 ;;
    --host) host="$2"; shift 2 ;;
    *) break ;;
  esac
done
if [ -z "$files" ]; then
  files="${FORGE_TOKEN_FILE:-/run/fleet/forge-token}$nl/run/secrets/github-token$nl"
fi

if [ "${1:-}" != get ]; then
  cat >/dev/null
  exit 0
fi

protocol=""
req_host=""
seen_protocol=0
seen_host=0
while IFS= read -r line; do
  [ -n "$line" ] || break
  case "$line" in
    protocol=*) protocol="${line#protocol=}"; seen_protocol=$((seen_protocol + 1)) ;;
    host=*) req_host="${line#host=}"; seen_host=$((seen_host + 1)) ;;
  esac
done

# A request with two protocol= or host= lines is not from git: it is unclear which to check.
[ "$seen_protocol" -eq 1 ] && [ "$seen_host" -eq 1 ] || exit 0
[ "$protocol" = https ] || exit 0
[ "$req_host" = "$host" ] || exit 0

# The first non-empty file in order. Only a regular file (a symlink to one too), not larger
# than MAX_TOKEN_BYTES; the token is visible ASCII without spaces.
token=""
old_ifs="$IFS"
IFS="$nl"
for file in $files; do
  [ -f "$file" ] && [ -r "$file" ] || continue
  value="$(head -c "$((MAX_TOKEN_BYTES + 1))" "$file" 2>/dev/null | tr -d '\r\n')" || continue
  [ -n "$value" ] || continue
  [ "${#value}" -le "$MAX_TOKEN_BYTES" ] || continue
  case "$value" in
    *[![:graph:]]*) continue ;;
  esac
  token="$value"
  break
done
IFS="$old_ifs"
[ -n "$token" ] || exit 0

printf 'username=x-access-token\npassword=%s\n' "$token"
