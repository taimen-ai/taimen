#!/bin/sh
# Configures git of the agent runner to use the forge credential helper. Called by
# runner-entrypoint in every mode; writes `credential.helper` into the global git
# configuration (GIT_CONFIG_GLOBAL, otherwise ~/.gitconfig).
#
# The token never goes into the configuration — only the paths of the files the helper reads
# on every request, in order: FORGE_TOKEN_FILE (by default the node-issued secret
# /run/fleet/forge-token), then the static /run/secrets/github-token. A file that does not
# exist at start-up is picked up as soon as it appears.
#
# git parses the helper line with a shell, so the values are checked before substitution:
# the path is absolute from [A-Za-z0-9/._-], the host is a DNS name. Otherwise the start fails.
#
#   runner-forge-credentials [--helper PATH]
#
# --helper — the path of the helper itself (default /usr/local/bin/git-credential-forge-token).
set -eu

helper=/usr/local/bin/git-credential-forge-token
if [ "${1:-}" = --helper ]; then
  helper="${2:?runner-forge-credentials: --helper without a value}"
fi
forge_file="${FORGE_TOKEN_FILE:-/run/fleet/forge-token}"
fallback_file=/run/secrets/github-token
forge_host="${FORGE_HOST:-github.com}"

fail() {
  echo "runner: $1" >&2
  exit 1
}

safe_path() {
  case "$2" in
    /*) ;;
    *) fail "$1 must be an absolute path" ;;
  esac
  case "$2" in
    *[!A-Za-z0-9/._-]*) fail "$1 has characters outside A-Z a-z 0-9 / . _ -" ;;
  esac
}

dns_name() {
  case "$1" in
    '' | *[!A-Za-z0-9.-]* | .* | *. | -* | *- | *..* | *.-* | *-.*)
      fail "FORGE_HOST must be a DNS name" ;;
  esac
  [ "${#1}" -le 253 ] || fail "FORGE_HOST must be a DNS name"
  rest="$1"
  while [ -n "$rest" ]; do
    label="${rest%%.*}"
    [ "${#label}" -le 63 ] || fail "FORGE_HOST must be a DNS name"
    case "$rest" in
      *.*) rest="${rest#*.}" ;;
      *) rest="" ;;
    esac
  done
}

safe_path "the helper path" "$helper"
safe_path FORGE_TOKEN_FILE "$forge_file"
dns_name "$forge_host"

git config --global credential.helper \
  "$helper --file '$forge_file' --file '$fallback_file' --host '$forge_host'"
