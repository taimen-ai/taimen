# The environment of a fleet node: copy to .env next to it (not in git).
# Substituted into node.yaml through compose.yml.

# The node's name, unique within the installation: ^[a-z0-9][a-z0-9.-]*$
FLEET_NODE_NAME=laptop-1
# The installation's address and its routes as the node's containers reach them (the fleet
# profile must be running there). A production installation — its public https address. A
# local installation on the same machine — host.docker.internal (Docker Desktop; the local
# Caddyfile serves this name too); on Linux — the host's address in the local network.
CONTROL_PLANE_SERVER=http://host.docker.internal
CONTROL_PLANE_IAM_URL=http://host.docker.internal/iam
FLEET_CONTROLLER_URL=http://host.docker.internal/fleet
# The node's directory on the host: state/ and secrets/ (0700)
#FLEET_HOME=/home/<user>/.taimen-fleet
# Images: the agent runner (built by this compose) and fleet
#AGENT_RUNNER_IMAGE=taimen/agent-runner:local
#FLEET_IMAGE=taimen/fleet:local
