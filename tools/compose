#!/bin/sh
# docker compose for this repository (TAI-ADR-0064): the file is deploy/local/compose.yml,
# the project directory is the repository root (.env, secrets/, build contexts). The project
# name comes from `name:` in the file and from .env. COMPOSE_FILE is not written to .env:
# a bare `docker compose` at the root fails loudly instead of resolving paths from
# deploy/local/ by mistake.
#
# A root compose.override.yml (settings of your installation) is added as a second file
# when it exists: a bare `docker compose` would read it by itself, an explicit -f does not.
#
#   tools/compose --profile core --profile edge up -d
#   tools/compose logs -f control-plane-api
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$root/compose.override.yml" ]; then
  exec docker compose --project-directory "$root" -f "$root/deploy/local/compose.yml" -f "$root/compose.override.yml" "$@"
fi
exec docker compose --project-directory "$root" -f "$root/deploy/local/compose.yml" "$@"
